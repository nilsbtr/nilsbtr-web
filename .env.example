# Copy this file to .env.local for local development.
# DATABASE_URL should point to a Neon development branch.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""
DATABASE_URL=""

# Operator details shown in the imprint and the privacy policy. Required in
# production: German law asks for a postal address (no PO box) and an email.
# LEGAL_ADDRESS takes the lines of the address separated by commas, e.g.
# "Musterstraße 1, 12345 Musterstadt, Deutschland". LEGAL_NAME defaults to the
# site's name and LEGAL_PHONE is optional.
LEGAL_NAME=""
LEGAL_ADDRESS=""
LEGAL_EMAIL=""
LEGAL_PHONE=""
