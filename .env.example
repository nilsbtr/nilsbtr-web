# Copy this file to .env.local for local development.
# DATABASE_URL should point to a Neon development branch.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""
DATABASE_URL=""

# Controller details shown in the privacy policy. LEGAL_EMAIL is required in
# production, as visitors need a way to reach you about their data. LEGAL_NAME
# defaults to the site's name. LEGAL_ADDRESS and LEGAL_PHONE are optional;
# the address takes its lines separated by commas, e.g.
# "Musterstraße 1, 12345 Musterstadt, Deutschland".
LEGAL_NAME=""
LEGAL_ADDRESS=""
LEGAL_EMAIL=""
LEGAL_PHONE=""
